{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.github.mdink",
  "applicationName": "mdink",
  "version": "1.0.0",
  "author": "mdink",
  "description": "mdink - portable Markdown viewer",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "app",
  "storageLocation": "app",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": [
    "app.exit",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.getStats",
    "storage.*",
    "os.showOpenDialog",
    "os.open",
    "window.setTitle",
    "window.print",
    "window.focus"
  ],
  "modes": {
    "window": {
      "title": "mdink",
      "width": 1100,
      "height": 820,
      "minWidth": 520,
      "minHeight": 360,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "useSavedState": true,
      "emitDropEvents": true,
      "newWindowPolicy": "browser"
    }
  },
  "cli": {
    "binaryName": "mdink",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
